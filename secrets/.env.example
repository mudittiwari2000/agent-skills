# agent-skills secrets template — KEY NAMES ONLY, never commit values.
# Real values live in ~/.config/agent-secrets/.env (chmod 600).
# `bash install.sh --bootstrap-secrets` creates/fills it from the fallback
# files your overlay's secrets.conf names. An organisation that already uses
# other key names can keep them: map them with `alias` lines in secrets.conf.

# --- Atlassian (Jira Cloud + Confluence Cloud can share one API token) ---
JIRA_BASE_URL=
JIRA_USER_EMAIL=
JIRA_API_TOKEN=

# Optional Confluence-specific overrides; when empty, skills fall back to
# the JIRA_* values above.
CONFLUENCE_BASE_URL=
CONFLUENCE_USER_EMAIL=
CONFLUENCE_API_TOKEN=

# --- GitLab ---
GITLAB_HOST=
GITLAB_TOKEN=
GITLAB_PERSONAL_ACCESS_TOKEN=

# --- Figma ---
FIGMA_API_KEY=

# --- Datadog ---
DD_API_KEY=
DD_APP_KEY=
DD_SITE=
