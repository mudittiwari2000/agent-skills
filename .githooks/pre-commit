#!/usr/bin/env bash
# Block commits that would publish secrets or organisation-specific strings,
# or that leave the skills tour out of date with the skills.
# Enabled by install.sh (git config core.hooksPath .githooks).
root="$(git rev-parse --show-toplevel)"
"$root/scripts/check-public-safe.sh" || exit 1
python3 "$root/scripts/build-tour.py" --check || { echo "Run: python3 scripts/build-tour.py (and add docs/tour/tour.json entries for new skills)" >&2; exit 1; }
